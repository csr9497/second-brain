{
  "name": "second-brain",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm --filter @sb/web dev",
    "dev:local": "pnpm --filter @sb/web dev:local",
    "build": "pnpm --filter @sb/web build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:env": "supabase status -o env | sed -n 's/^API_URL=/VITE_SUPABASE_URL=/p; s/^ANON_KEY=/VITE_SUPABASE_ANON_KEY=/p' > apps/web/.env.docker.local",
    "db:push:dev": ". ./.env.dev.local && supabase db push --db-url \"$SUPABASE_DEV_DB_URL\"",
    "db:reset:dev": ". ./.env.dev.local && supabase db reset --db-url \"$SUPABASE_DEV_DB_URL\""
  }
}
