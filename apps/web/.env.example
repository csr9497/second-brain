# Cada modo de Vite lee su propio archivo (todos ignorados por git):
#   pnpm dev        → apps/web/.env.dev.local     Supabase dev en la nube (second-brain-dev)
#   pnpm dev:local  → apps/web/.env.docker.local  Supabase local en Docker (lo genera `pnpm db:env`)
# Producción no usa archivos: GitHub Actions inyecta las variables del repo.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=
